rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function myUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Reading a field that isn't there is an error in rules, and documents written
    // by older app versions may lack isAdmin or teamId — so every lookup defaults.
    function myUserData() {
      return get(myUserPath()).data;
    }

    // Platform admin: may run every game and manage players
    function isAdmin() {
      return isAuth()
        && exists(myUserPath())
        && myUserData().get('isAdmin', false) == true;
    }

    // Hosts are listed on the game they run. A game without hostIds can only be
    // run by platform admins, which keeps games created before hosting existed safe.
    function gameHosts(gameId) {
      return exists(/databases/$(database)/documents/games/$(gameId))
        ? get(/databases/$(database)/documents/games/$(gameId)).data.get('hostIds', [])
        : [];
    }

    function myTeamId() {
      return isAuth() && exists(myUserPath()) ? myUserData().get('teamId', null) : null;
    }

    // A gameplay entry a player may write for their own team
    function isOwnGameplayEntry() {
      return isAuth()
        && request.resource.data.teamId == myTeamId()
        && request.resource.data.type in ['quest_solved', 'team_finished', 'hint_revealed'];
    }

    function canManageGame(gameId) {
      return isAdmin() || (isAuth() && request.auth.uid in gameHosts(gameId));
    }

    // Users: own doc is readable/writable by self; admins can read all
    // create is allowed for any authenticated user so signup can write the initial doc
    match /users/{uid} {
      // Own doc, admin, or a teammate (same teamId, non-null)
      // Note: isAdmin() uses get() which works for single-doc reads but not list queries;
      // list queries (e.g. where documentId() in [...]) use the allow list rule below.
      allow read:   if isAuth() && (
                      request.auth.uid == uid
                      || (resource.data.get('teamId', null) != null
                          && resource.data.get('teamId', null) == myTeamId())
                      || isAdmin()
                    );
      allow list:   if isAdmin();
      allow create: if isAuth() && request.auth.uid == uid;
      // Users may update their own doc but cannot promote themselves to admin
      allow update: if isAdmin()
                    || (request.auth.uid == uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']));
      allow delete: if isAdmin();
    }

    // Games + nested quests: authenticated users read; admins write
    match /games/{gameId} {
      allow read:   if isAuth();
      // Whoever creates a game must list themselves as a host
      allow create: if isAdmin() || (isAuth() && request.auth.uid in request.resource.data.hostIds);
      allow update, delete: if canManageGame(gameId);

      match /quests/{questId} {
        allow read:  if isAuth();
        allow write: if canManageGame(gameId);
      }

      // Chat: one thread per team. A team sees only its own thread; hosts see all.
      match /messages/{messageId} {
        allow read: if isAuth() && (resource.data.teamId == myTeamId() || canManageGame(gameId));
        allow create: if (
                        isAuth()
                        && request.resource.data.teamId == myTeamId()
                        && request.resource.data.authorId == request.auth.uid
                        && request.resource.data.fromHost == false
                      ) || canManageGame(gameId);
        allow update, delete: if canManageGame(gameId);
      }

      // Wrong answers: teams write their own, only hosts read them. Teams must not
      // see what other teams have tried.
      match /attempts/{attemptId} {
        allow read: if canManageGame(gameId);
        allow create: if isAuth() && request.resource.data.teamId == myTeamId();
        allow update, delete: if canManageGame(gameId);
      }

      // Activity feed: 'public' entries are readable by everyone in the game,
      // 'team' entries only by that team and admins. Players may only write
      // their own team's gameplay entries, and nobody but an admin may edit one.
      match /activity/{entryId} {
        allow read: if isAuth() && (
                      resource.data.visibility == 'public'
                      || resource.data.teamId == myTeamId()
                      || canManageGame(gameId)
                    );
        // Entry ids are derived from the quest, so two teammates acting at the same
        // moment — or any retried write — land on the same document. That has to be
        // an allowed overwrite: these entries travel in the same batch as the team's
        // progress, and refusing one would stop the team from advancing.
        allow create: if isOwnGameplayEntry() || canManageGame(gameId);
        allow update: if (isOwnGameplayEntry() && resource.data.teamId == myTeamId())
                      || canManageGame(gameId);
        allow delete: if canManageGame(gameId);
      }
    }

    // Teams: authenticated users read; admins write
    // Team members may update only the quest progress fields
    match /teams/{id} {
      allow read:   if isAuth();
      allow create: if canManageGame(request.resource.data.gameId);
      allow delete: if canManageGame(resource.data.gameId);
      // The team-member clause comes first so a player's own writes are decided
      // without any document lookups at all
      allow update: if (isAuth()
                        && request.auth.uid in resource.data.memberIds
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['currentQuestId', 'completedQuestIds', 'finishedAt',
                                       'questProgress', 'coins', 'hintsRevealed',
                                       'teamChatReadAt']))
                    || canManageGame(resource.data.gameId);

      // Coin ledger: a record of admin adjustments; players may read their own team's history
      match /coinLedger/{entryId} {
        allow read:  if isAuth();
        allow write: if canManageGame(get(/databases/$(database)/documents/teams/$(id)).data.gameId);
      }
    }

    // Shop items: authenticated users read; admins write
    match /shopItems/{id} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // Broadcasts (admin push messages): authenticated users read; admins write
    match /broadcasts/{id} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // Game settings: authenticated users read; admins write
    match /settings/{id} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // Location trail: players write their own points; only admins read
    match /trail/{trailId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read:   if canManageGame(resource.data.gameId);
    }

    // Registrations: anyone can submit; only admins manage them
    match /registrations/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
