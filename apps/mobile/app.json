{
  "expo": {
    "name": "Grand City Race",
    "slug": "gcr26",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app-icons/ios/AppIcon.appiconset/AppIcon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gcr.app26",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Grand City Race tracks your location in the background so your team's trail stays up to date on the map.",
        "NSLocationAlwaysUsageDescription": "Grand City Race tracks your location in the background so your team's trail stays up to date on the map.",
        "NSLocationWhenInUseUsageDescription": "Grand City Race uses your location to unlock nearby quests and show your position on the map."
      },
      "icon": {
        "light": "./app-icons/ios/AppIcon.appiconset/AppIcon-1024.png",
        "dark": "./app-icons/ios/AppIcon.appiconset/AppIcon-1024-dark.png",
        "tinted": "./app-icons/ios/AppIcon.appiconset/AppIcon-1024-tinted.png"
      }
    },
    "android": {
      "package": "com.gcrace.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./app-icons/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "monochromeImage": "./app-icons/android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./app-icons/ios/AppIcon.appiconset/AppIcon-1024.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ec849fa3-413f-4770-a121-e51f1fa7a37a"
      }
    },
    "owner": "timschaeren"
  }
}
